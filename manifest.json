{
  "name": "One Word Answers for ChatGPT",
  "description": "Adds text to every chat gpt prompt",
  "manifest_version": 3,
  "version": "1.0",
  "action": {
    "default_popup": "oneWord.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}


